{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/android/.gradle/**": true,
    "**/android/app/build/**": true,
    "**/linux/flutter/ephemeral/**": true,
    "**/windows/flutter/ephemeral/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/build": true,
    "**/.dart_tool": true,
    "**/android/.gradle": true
  },
  "dart.analysisExcludedFolders": [
    "build",
    ".dart_tool",
    "android/.gradle",
    "linux/flutter/ephemeral"
  ]
}
